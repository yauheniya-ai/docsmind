# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Testing / linting / type-checking ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- uv / pip ---
uv.lock.bak

# --- docsmind local runtime artifacts ---
# Local filesystem BlobStore (extracted images from ingestion) — never
# something to commit; it's per-machine, per-ingest state.
.docsmind/
# Generated by scripts/make_test_pdf.py for local testing — not a committed
# fixture (tests/unit/test_pdf_parser.py generates its own PDF in-memory).
/sample.pdf

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Postgres (local Docker volume mounts, if you ever add bind mounts) ---
*.sql.bak

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Jupyter, if you use it for exploration ---
.ipynb_checkpoints/

# --- Alembic ---
# (versions/ IS tracked — only local scratch files some editors drop here)
alembic/versions/*.pyc

# --- ui/ (Vite/React build output, once ui/ has a real app in it) ---
ui/node_modules/
ui/dist/
