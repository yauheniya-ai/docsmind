# Copy to .env and fill in. All vars are prefixed DOCSMIND_ (see config.py).

# --- storage: pick ONE path below ---

# Path A: local Docker (docsmind db up)
DOCSMIND_DATABASE_URL=postgresql+asyncpg://docsmind:docsmind@localhost:5432/docsmind

# Path B: Supabase (Storage bucket doubles as blob store)
# DOCSMIND_DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project>.supabase.co:5432/postgres
# DOCSMIND_BLOB_BACKEND=supabase
# DOCSMIND_SUPABASE_URL=https://<project>.supabase.co
# DOCSMIND_SUPABASE_KEY=<service_role_key>

# Path C: Neon (pair with an S3-compatible bucket, e.g. Cloudflare R2)
# DOCSMIND_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<project>.neon.tech/docsmind
# DOCSMIND_BLOB_BACKEND=s3
# DOCSMIND_S3_BUCKET=docsmind-images
# DOCSMIND_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# --- models ---
DOCSMIND_LLM_PROVIDER=anthropic
DOCSMIND_LLM_MODEL=claude-sonnet-4-6
DOCSMIND_EMBEDDING_PROVIDER=openai
DOCSMIND_EMBEDDING_MODEL=text-embedding-3-large
# DOCSMIND_EMBEDDING_DIMENSIONS=3072   # native size; shorten via API's `dimensions` param if needed
DOCSMIND_VISION_PROVIDER=anthropic

DOCSMIND_ANTHROPIC_API_KEY=
DOCSMIND_OPENAI_API_KEY=
