# Copy to .env and fill in. All vars are prefixed DOCSMIND_ (see config.py).

# --- storage: pick ONE path below ---

# Path A: local Docker (docsmind db up)
DOCSMIND_DATABASE_URL=postgresql+asyncpg://docsmind:docsmind@localhost:5434/docsmind

# Path B: Supabase (Storage bucket doubles as blob store)
# DOCSMIND_DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project>.supabase.co:5432/postgres
# DOCSMIND_BLOB_BACKEND=supabase
# DOCSMIND_SUPABASE_URL=https://<project>.supabase.co
# DOCSMIND_SUPABASE_KEY=<service_role_key>

# Path C: Neon (pair with an S3-compatible bucket, e.g. Cloudflare R2)
# DOCSMIND_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<project>.neon.tech/docsmind
# DOCSMIND_BLOB_BACKEND=s3
# DOCSMIND_S3_BUCKET=docsmind-images
# DOCSMIND_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# --- models ---
DOCSMIND_LLM_PROVIDER=openai
DOCSMIND_LLM_MODEL=gpt-6.1-terra
# Cheaper model for the small jobs of every agent: routing, summarizing, memory notes, the versions
# check and the matching of changelog entries (defaults to DOCSMIND_LLM_MODEL)
# DOCSMIND_AGENT_FAST_MODEL=
DOCSMIND_EMBEDDING_PROVIDER=openai
DOCSMIND_EMBEDDING_MODEL=text-embedding-3-large
# DOCSMIND_EMBEDDING_DIMENSIONS=3072   # native size; shorten via API's `dimensions` param if needed
DOCSMIND_VISION_PROVIDER=openai
# Optional: choose a specific captioning model (defaults: gpt-6-luna / claude-sonnet-5-5)
# DOCSMIND_VISION_MODEL=gpt-6-luna

DOCSMIND_OPENAI_API_KEY=
# Only needed if you switch a provider above to anthropic (e.g. DOCSMIND_LLM_PROVIDER=anthropic,
# DOCSMIND_LLM_MODEL=claude-sonnet-5-5).
# DOCSMIND_ANTHROPIC_API_KEY=
# Behind a company gateway or proxy? Set the key AND the base URL of that provider. Leave a
# base URL unset (or empty) to use the provider's own endpoint. It applies to the chat model,
# the embeddings and the vision model of that provider.
#   OpenAI-compatible: the URL usually ends in /v1, e.g. https://llm-gateway.example.com/openai/v1
#   Anthropic: without /v1, e.g. https://llm-gateway.example.com/anthropic
# DOCSMIND_ANTHROPIC_BASE_URL=
# DOCSMIND_OPENAI_BASE_URL=

# --- on-demand enrichment (optional estimator overrides) ---
# Prices are USD per 1M tokens. The built-in table (src/docsmind/pricing.py) covers gpt-6.1-sol,
# gpt-6.1-terra, gpt-6-luna, claude-sonnet-5 and text-embedding-3-large; these override it
# for the estimate dialogs/CLI output.
# DOCSMIND_EMBEDDING_PRICE_PER_MILLION=
# DOCSMIND_VISION_INPUT_PRICE_PER_MILLION=
# DOCSMIND_VISION_OUTPUT_PRICE_PER_MILLION=
# DOCSMIND_VISION_MAX_OUTPUT_TOKENS=300
# DOCSMIND_EMBEDDING_BATCH_SIZE=64

# --- the Mind (chat agent); everything optional ---
# DOCSMIND_AGENT_MAX_STEPS=8
# DOCSMIND_AGENT_MEMORY_ENABLED=true
# For reasoning models that reject tools: none | minimal | low | medium | high
# DOCSMIND_OPENAI_REASONING_EFFORT=

# --- web access (optional) ---
# Tavily (https://tavily.com) API key. Enables the `web_search` tool, which only the Change
# Analyzer subagent gets: when comparing two versions of a document it looks for a published
# changelog online if the documents don't include one. Keys start with "tvly-"; Tavily has a
# free tier. Unset = no web search (the Change Analyzer's `fetch_url` tool still reads pages).
# DOCSMIND_WEB_SEARCH_API_KEY=tvly-...

# --- Change Analyzer (comparing two versions); everything optional ---
# Share of changed sentences at or above which the scan sees both versions in full instead of
# the current version plus a diff.
# DOCSMIND_CHANGE_DIFF_THRESHOLD=0.25
# Long-context model for the scan (defaults to DOCSMIND_LLM_MODEL).
# DOCSMIND_CHANGE_SCAN_MODEL=
# Documents that do not fit one scan call are split: input limit and part size, in tokens.
# DOCSMIND_CHANGE_SCAN_MAX_INPUT_TOKENS=180000
# DOCSMIND_CHANGE_SCAN_SPLIT_TOKENS=90000
# DOCSMIND_CHANGE_SCAN_MAX_OUTPUT_TOKENS=32000
# DOCSMIND_CHANGE_SCAN_MAX_RETRIES=3
# Rows verified at the same time, and tool steps per row / for the changelog search.
# DOCSMIND_CHANGE_VERIFY_PARALLEL=4
# DOCSMIND_CHANGE_VERIFY_MAX_STEPS=8
# Relaunches of a row check that failed technically (no usable answer) before it stays unverified.
# DOCSMIND_CHANGE_VERIFY_MAX_RETRIES=3
# DOCSMIND_CHANGE_CHANGELOG_MAX_STEPS=14
# `page_vision` (needs the vision provider's key): page image resolution and answer size.
# DOCSMIND_CHANGE_VISION_DPI=130
# DOCSMIND_CHANGE_VISION_MAX_OUTPUT_TOKENS=1500
# `load_table`: largest spreadsheet downloaded, in bytes.
# DOCSMIND_CHANGE_TABLE_MAX_BYTES=10000000
# The Change Analyzer's own loop: steps (one model turn; parallel tool calls count once) per request,
# and model calls per request in total, loops inside tools included. The call cap is a rough
# boundary to tune empirically (a 30-page questionnaire takes 100+ calls, a long standard ~300). The report is
# always written, even past the cap.
# DOCSMIND_CHANGE_AGENT_MAX_STEPS=25
# DOCSMIND_CHANGE_REQUEST_MAX_MODEL_CALLS=1000
# Readers and files: a PDF page with fewer characters needs vision; file size/cell limits of `create_file`.
# DOCSMIND_READ_URL_MIN_CHARS_PER_PAGE=100
# Largest PDF or Word file read_url downloads.
# DOCSMIND_READ_URL_MAX_BYTES=25000000
# DOCSMIND_CREATE_FILE_MAX_BYTES=5000000
# DOCSMIND_CREATE_FILE_MAX_CELLS=50000
# Price overrides per model prefix, USD per 1M tokens, as JSON. Any field may be left out; a missing cached
# or cache-write price falls back to the input price (the cost is then shown as an upper bound).
# DOCSMIND_MODEL_PRICES={"gpt-6.1-terra": {"input": 1.0, "cached_read": 0.1, "cache_write": 1.0, "output": 5.0}}
